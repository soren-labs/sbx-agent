FROM node:22-alpine AS console
WORKDIR /console
COPY console/package*.json ./
RUN npm ci
COPY console/ ./
RUN npm run build
FROM python:3.12-slim
WORKDIR /opt/sbx
COPY pyproject.toml uv.lock README.md ./
COPY protocol ./protocol
COPY control ./control
COPY runtime ./runtime
COPY src ./src
RUN pip install --no-cache-dir .
COPY --from=console /console/dist /opt/sbx/console/dist
RUN useradd -m -u 10001 sbx && mkdir /state && chown sbx:sbx /state
USER sbx
EXPOSE 8787
ENTRYPOINT ["python", "-m", "control.serve"]
