# Reference for operator overrides. On first deployment bootstrap.sh creates
# /opt/sbx-agent/.env with the required generated secrets and mode 0600.
# The runtime image itself is written by the release workflow into release.env.

SBX_POSTGRES_PASSWORD=<secret>
SBX_VAULT_KEYS=k1:<base64-32-bytes>
SBX_RUNTIME_MASTER_KEY=<hex-32-bytes>

SBX_PUBLIC_URL=https://sbx-agent.com
SBX_ALLOWED_ORIGINS=https://sbx-agent.com
SBX_COOKIE_SECURE=1
SBX_EXECUTORS=modal
SBX_WORKER_THREADS=4

# Optional production email.
# SBX_RESEND_API_KEY=<secret>
# SBX_MAIL_FROM=SBX Agent <no-reply@sbx-agent.com>
