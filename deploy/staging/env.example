# Reference for /opt/sbx-staging/.env. bootstrap.sh generates this file on the
# staging host with fresh host-local secrets and mode 0600. Staging never
# shares a database password, Vault key or runtime master key with production.
# The image reference is written by deploy.sh into release.env.

SBX_POSTGRES_PASSWORD=<secret>
SBX_VAULT_KEYS=stg1:<base64-32-bytes>
SBX_RUNTIME_MASTER_KEY=<hex-32-bytes>

# Browser origin of the staging Console. Must be a staging-only hostname.
SBX_PUBLIC_URL=https://staging.sbx-agent.com
SBX_ALLOWED_ORIGINS=https://staging.sbx-agent.com
SBX_COOKIE_SECURE=1
SBX_EXECUTORS=modal
SBX_WORKER_THREADS=2

# Optional container memory ceilings (defaults fit a 2 GiB host).
# SBX_STAGING_APP_MEMORY=900m
# SBX_STAGING_POSTGRES_MEMORY=512m

# Optional staging email. Without it, verification mail is written to the
# sbx_data volume under mail/ and never leaves the host.
# SBX_RESEND_API_KEY=<secret>
# SBX_MAIL_FROM=SBX Agent Staging <no-reply@staging.sbx-agent.com>
