[Unit]
Description=SBX Hosted Alpha control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sbx
Group=sbx
WorkingDirectory=/opt/sbx-browser
EnvironmentFile=/etc/sbx-hosted.env
Environment=HOME=/var/lib/sbx-hosted
Environment=XDG_STATE_HOME=/var/lib/sbx-hosted/state
ExecStart=/opt/sbx-browser/.venv/bin/uvicorn control.hosted_server:create_hosted_app --factory --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
StateDirectory=sbx-hosted
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sbx-hosted

[Install]
WantedBy=multi-user.target
