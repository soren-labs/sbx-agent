api.sbx-agent.com {
    # Only the local reverse proxy is trusted for forwarded scheme/host.
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    # SSE uses normal streaming responses; no CDN/proxy buffering layer.
}
