# Contract only. Install outside the checkout with mode 0600; never commit values.
SBX_HOSTED=1
SBX_STATE_BACKEND=postgres
SBX_BACKEND=local
DATABASE_URL=postgresql://REDACTED
SBX_CONNECTION_ENCRYPTION_KEY=REDACTED
SBX_BROWSER_ORIGINS=https://sbx-agent.com
SBX_CONNECTIONS_MODE=production
SBX_AUTH_EMAIL_MODE=production
SBX_OPERATOR_AUTH_ENABLED=0
# Credentialed factory installed on VPS; it returns five injected adapters.
SBX_HOSTED_ADAPTER_FACTORY=control.production_adapters:create_adapters
SBX_DEFAULT_MODEL=gpt-6.1-sol
SBX_CODEX_CONTROL_BIN=/usr/local/bin/codex
SBX_CODEX_BROKER_TMP=/run/sbx-hosted/codex
SBX_CODEX_IMPORT_ROOT=/var/lib/sbx-hosted/import
RESEND_API_KEY=REDACTED
SBX_AUTH_EMAIL_DOMAIN=sbx-agent.com
SBX_AUTH_EMAIL_FROM=SBX Agent <verify@sbx-agent.com>
SBX_GITHUB_APP_ID=REDACTED
SBX_GITHUB_APP_SLUG=sbx-agent
SBX_GITHUB_APP_PRIVATE_KEY_PATH=/etc/sbx/github-app.pem
# Provider-specific secrets belong to that factory's environment contract.
# Never pass Modal credentials or AI refresh credentials to the frontend.
