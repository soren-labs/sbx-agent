# sbx-browser — example environment. Copy to .env and fill in.
# NEVER commit real values. Anything marked <secret> belongs in your secret
# manager or local shell — not in git, issues, logs or PRs.

# ------------------------------------------------------------- control plane ---
SBX_DATABASE_URL=postgresql://sbx@localhost:5432/sbx    # <secret> if it embeds a password
SBX_VAULT_KEYS=k1:<base64-32-bytes>                    # <secret>; first key is active
SBX_RUNTIME_MASTER_KEY=<hex-32-bytes>                  # <secret>; derives per-lease runtime keys
SBX_PUBLIC_URL=http://localhost:5174                   # Console origin used in email links
SBX_ALLOWED_ORIGINS=http://localhost:5174
#SBX_COOKIE_SECURE=1                                   # set behind HTTPS
#SBX_EXECUTORS=local,modal
#SBX_DATA_DIR=./.sbx-data                              # local mail outbox and runtime data
#SBX_WORKER_THREADS=4
#SBX_RESEND_API_KEY=<secret>                           # optional; otherwise $SBX_DATA_DIR/mail
#SBX_MAIL_FROM="SBX <no-reply@your-domain>"            # required with Resend; verified sender domain

# ------------------------------------------------------------------- client ---
# Used by the sbx CLI/SDK and examples/unified_mvp.py.
SBX_BASE_URL=http://127.0.0.1:8800
#SBX_API_KEY=<secret>

# Provider, Modal and GitHub credentials are NOT environment variables: add
# them as Connections in the Console or with `sbx connections add`.
